#root {
  max-width: none;
  margin: 0;
  padding: 0;
  width: 100%;
}

.app {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  color: #4a4a52;
  width: 100%;
  overflow-x: hidden;
}

/* Keep some utility classes from original */
.card {
  padding: 2em;
}

.read-the-docs {
  color: #444;
}

/* Smooth scroll behavior */
html {
  scroll-behavior: smooth;
}

/* Glass card utility for any ad-hoc usage */
.glass-card {
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(217, 168, 199, 0.25);
  box-shadow: 0 8px 32px rgba(217, 168, 199, 0.15);
  border-radius: 24px;
  transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
}

.glass-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 40px rgba(217, 168, 199, 0.2);
}

/* Accent pill button */
.btn-accent {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.85rem 2rem;
  background: linear-gradient(135deg, #d9a8c7 0%, #f2a8c5 100%);
  color: #fff;
  font-family: 'Poppins', sans-serif;
  font-weight: 600;
  font-size: 0.95rem;
  border: none;
  border-radius: 9999px;
  cursor: pointer;
  transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 4px 16px rgba(217, 168, 199, 0.3);
  text-decoration: none;
}

.btn-accent:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(217, 168, 199, 0.4);
}

/* Scroll reveal animation classes */
.scroll-fade-in {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 500ms cubic-bezier(0.4, 0, 0.2, 1),
              transform 500ms cubic-bezier(0.4, 0, 0.2, 1);
}

.scroll-fade-in.in-view {
  opacity: 1;
  transform: translateY(0);
}
